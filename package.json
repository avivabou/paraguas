{
  "name": "paraguas",
  "version": "0.2.0",
  "description": "Generic i18n mechanism: recipe-based locale build pipeline, typed runtime proxy with embedded-component rendering, and a server-side loader",
  "license": "MIT",
  "author": "avivabou",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/avivabou/paraguas.git"
  },
  "keywords": [
    "i18n",
    "typescript",
    "icu",
    "locale",
    "namespaces",
    "embeds"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js",
      "require": "./dist/server.cjs"
    },
    "./build": {
      "types": "./dist/build.d.ts",
      "import": "./dist/build.js",
      "require": "./dist/build.cjs"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js",
      "require": "./dist/react.cjs"
    },
    "./react-i18next": {
      "types": "./dist/react-i18next.d.ts",
      "import": "./dist/react-i18next.js",
      "require": "./dist/react-i18next.cjs"
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --typecheck",
    "test:watch": "vitest",
    "prepublishOnly": "npm run typecheck && npm run test && npm run build"
  },
  "dependencies": {
    "intl-messageformat": "^11.2.4",
    "keys-weaver": "^0.1.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "tsup": "^8.3.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0",
    "react": "^18.3.0",
    "@types/react": "^18.3.0",
    "react-i18next": "^15.0.0",
    "i18next": "^23.16.0"
  },
  "peerDependencies": {
    "react": ">=17",
    "react-i18next": ">=13",
    "i18next": ">=23"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-i18next": {
      "optional": true
    },
    "i18next": {
      "optional": true
    }
  },
  "bin": {
    "paraguas-merge-locales": "dist/merge-driver-cli.cjs"
  }
}
